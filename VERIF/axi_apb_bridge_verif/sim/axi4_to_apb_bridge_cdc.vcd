   $var wire 1 ," PREADY $end
   $var wire 1 r" PSLVERR $end
   $var wire 32 @! data_reg [31:0] $end
   $var wire 32 A! ctrl_reg [31:0] $end
   $var wire 32 B! baud_reg [31:0] $end
   $var wire 32 C! irq_status_reg [31:0] $end
   $var wire 32 D! wait_count [31:0] $end
   $var wire 1 ," apb_access $end
  $upscope $end
 $upscope $end
$enddefinitions $end



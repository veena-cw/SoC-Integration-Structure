`verilator_config
// Code coverage is collected for the design (DSN/...) only. The testbench,
// the UVM library and Verilator's own SystemVerilog sources are not
// instrumented, so they do not appear in coverage.dat or the reports.
coverage_off -file "*/VERIF/uvm-1.1d/*"
coverage_off -file "*/VERIF/cpu_verif/*"
coverage_off -file "*/VERIF/plic_verif/*"
coverage_off -file "*/share/verilator/*"

// Features not supported in this CPU version (see coverage_waivers.txt;
// keep both lists in sync).
// Sv39 virtual memory: page-table walker, TLBs, TLB lookup / page faults
coverage_off -file "*/bp_be/src/v/bp_be_calculator/bp_be_ptw.sv"
coverage_off -file "*/bp_common/src/v/bp_tlb.sv"

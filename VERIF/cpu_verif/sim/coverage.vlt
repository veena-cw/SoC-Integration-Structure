`verilator_config
// Code coverage is collected for the design (DSN/...) only. The testbench,
// the UVM library and Verilator's own SystemVerilog sources are not
// instrumented, so they do not appear in coverage.dat or the reports.
coverage_off -file "*/VERIF/uvm-1.1d/*"
coverage_off -file "*/VERIF/cpu_verif/*"
coverage_off -file "*/share/verilator/*"

// Features not supported in this CPU version (see coverage_waivers.txt;
// keep both lists in sync).
// Sv39 virtual memory: page-table walker, TLBs, TLB lookup / page faults
coverage_off -file "*/bp_be/src/v/bp_be_calculator/bp_be_ptw.sv"
coverage_off -file "*/bp_common/src/v/bp_tlb.sv"
coverage_off -file "*/bp_common/src/v/bp_mmu.sv" -lines 104-136
coverage_off -file "*/bp_common/src/v/bp_mmu.sv" -lines 177-190
coverage_off -file "*/bp_common/src/v/bp_mmu.sv" -lines 204-206

// Hazard detector: dep_status producer kinds the decoder never creates
coverage_off -file "*/bp_be/src/v/bp_be_checker/bp_be_detector.sv" -lines 275-275
coverage_off -file "*/bp_be/src/v/bp_be_checker/bp_be_detector.sv" -lines 277-277
coverage_off -file "*/bp_be/src/v/bp_be_checker/bp_be_detector.sv" -lines 281-282
coverage_off -file "*/bp_be/src/v/bp_be_checker/bp_be_detector.sv" -lines 285-286

// Integer divider / multiplier: arms fixed by parameters in this config
// (bits_per_iter_p == 2, imulh gets_high_part_i tied 1, bsg_mul_pipelined
// not instantiated)
coverage_off -file "*/external/basejump_stl/bsg_misc/bsg_idiv_iterative.sv" -lines 50-50
coverage_off -file "*/external/basejump_stl/bsg_misc/bsg_idiv_iterative_controller.sv" -lines 96-96

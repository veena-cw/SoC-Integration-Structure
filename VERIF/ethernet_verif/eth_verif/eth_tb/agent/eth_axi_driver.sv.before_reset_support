class eth_axi_driver extends uvm_driver #(eth_axi_item);
    `uvm_component_utils(eth_axi_driver)

    virtual eth_axi_if vif;

    bit [7:0] mem [longint unsigned];

    int unsigned     read_burst_count;
    int unsigned     read_beat_count;
    int unsigned     read_byte_count;
    longint unsigned first_read_addr;
    bit              first_read_seen;
    bit              read_error_seen;

    int unsigned     write_burst_count;
    int unsigned     write_beat_count;
    int unsigned     write_byte_count;
    longint unsigned first_write_addr;
    bit              first_write_seen;
    bit              write_error_seen;

    // Testbench-controlled AXI memory backpressure.
    bit              backpressure_enable;
    int unsigned     arready_delay_cycles;
    int unsigned     rvalid_delay_cycles;
    int unsigned     awready_delay_cycles;
    int unsigned     wready_delay_cycles;
    int unsigned     bvalid_delay_cycles;

    function new(string name, uvm_component parent);
        super.new(name, parent);

        backpressure_enable  = 1'b0;
        arready_delay_cycles = 0;
        rvalid_delay_cycles  = 0;
        awready_delay_cycles = 0;
        wready_delay_cycles  = 0;
        bvalid_delay_cycles  = 0;
    endfunction

    function void build_phase(uvm_phase phase);
        super.build_phase(phase);

        if (!uvm_config_db#(virtual eth_axi_if)::get(this, "", "vif", vif))
            `uvm_fatal("AXI_VIF", "Unable to get eth_axi_if")
    endfunction

    task run_phase(uvm_phase phase);

        vif.arready <= 1'b0;
        vif.rvalid  <= 1'b0;
        vif.rdata   <= '0;
        vif.rresp   <= 2'b00;
        vif.rlast   <= 1'b0;
        vif.rid     <= '0;

        vif.awready <= 1'b0;
        vif.wready  <= 1'b0;
        vif.bvalid  <= 1'b0;
        vif.bresp   <= 2'b00;
        vif.bid     <= '0;

        read_burst_count = 0;
        read_beat_count  = 0;
        read_byte_count  = 0;
        first_read_addr  = '0;
        first_read_seen  = 1'b0;
        read_error_seen  = 1'b0;

        write_burst_count = 0;
        write_beat_count  = 0;
        write_byte_count  = 0;
        first_write_addr  = '0;
        first_write_seen  = 1'b0;
        write_error_seen  = 1'b0;

        wait(vif.aresetn === 1'b1);

        `uvm_info("AXI_MEM",
            "AXI memory slave ready for DMA reads and writes",
            UVM_LOW)

        fork
            begin
                forever
                    service_read();
            end

            begin
                forever
                    service_write();
            end
        join
    endtask


    task service_read();

        bit [63:0]       start_addr;
        bit [7:0]        burst_len;
        bit [2:0]        burst_size;
        bit [3:0]        request_id;
        int unsigned     beat_count;
        int unsigned     bytes_per_beat;
        longint unsigned beat_addr;
        bit [63:0]       beat_data;

        if (backpressure_enable) begin

            vif.arready <= 1'b0;

            // Start the stall only after the DUT presents a valid request.
            do @(posedge vif.aclk);
            while (vif.arvalid !== 1'b1);

            repeat (arready_delay_cycles)
                @(posedge vif.aclk);

            vif.arready <= 1'b1;

        end
        else begin
            vif.arready <= 1'b1;
        end

        do @(posedge vif.aclk);
        while (!(vif.arvalid && vif.arready));

        start_addr = vif.araddr;
        burst_len  = vif.arlen;
        burst_size = vif.arsize;
        request_id = vif.arid;

        vif.arready <= 1'b0;

        read_burst_count++;

        if (!first_read_seen) begin
            first_read_addr = start_addr;
            first_read_seen = 1'b1;
        end

        if (vif.arburst != 2'b01) begin
            read_error_seen = 1'b1;
            `uvm_error("AXI_MEM_AR",
                $sformatf("Unsupported ARBURST=%0b ADDR=%016h",
                          vif.arburst, start_addr))
        end

        if (burst_size > 3) begin
            read_error_seen = 1'b1;
            `uvm_error("AXI_MEM_AR",
                $sformatf("Invalid ARSIZE=%0d for 64-bit AXI data bus",
                          burst_size))
        end

        beat_count     = burst_len + 1;
        bytes_per_beat = 1 << burst_size;

        `uvm_info("AXI_MEM_AR",
            $sformatf(
                "ADDR=%016h ARLEN=%0d BEATS=%0d ARSIZE=%0d BYTES_PER_BEAT=%0d",
                start_addr,
                burst_len,
                beat_count,
                burst_size,
                bytes_per_beat),
            UVM_LOW)

        for (int unsigned beat_index = 0;
             beat_index < beat_count;
             beat_index++) begin

            beat_addr = start_addr + (beat_index * bytes_per_beat);
            beat_data = '0;

            for (int unsigned byte_lane = 0;
                 byte_lane < bytes_per_beat && byte_lane < 8;
                 byte_lane++) begin

                if (mem.exists(beat_addr + byte_lane))
                    beat_data[(byte_lane*8) +: 8] =
                        mem[beat_addr + byte_lane];
                else
                    beat_data[(byte_lane*8) +: 8] = 8'h00;
            end

            if (backpressure_enable) begin
                repeat (rvalid_delay_cycles)
                    @(posedge vif.aclk);
            end

            vif.rid    <= request_id;
            vif.rdata  <= beat_data;
            vif.rresp  <= 2'b00;
            vif.rlast  <= (beat_index == beat_count-1);
            vif.rvalid <= 1'b1;

            do @(posedge vif.aclk);
            while (!vif.rready);

            read_beat_count++;
            read_byte_count += bytes_per_beat;

            `uvm_info("AXI_MEM_R",
                $sformatf(
                    "BEAT=%0d ADDR=%016h DATA=%016h RLAST=%0b",
                    beat_index,
                    beat_addr,
                    beat_data,
                    beat_index == beat_count-1),
                UVM_LOW)

            vif.rvalid <= 1'b0;
            vif.rlast  <= 1'b0;
        end
    endtask


    task service_write();

        bit [63:0]       start_addr;
        bit [7:0]        burst_len;
        bit [2:0]        burst_size;
        bit [3:0]        request_id;
        int unsigned     beat_count;
        int unsigned     bytes_per_beat;
        longint unsigned beat_addr;

        if (backpressure_enable) begin

            vif.awready <= 1'b0;

            // Start the stall only after the DUT presents a valid request.
            do @(posedge vif.aclk);
            while (vif.awvalid !== 1'b1);

            repeat (awready_delay_cycles)
                @(posedge vif.aclk);

            vif.awready <= 1'b1;

        end
        else begin
            vif.awready <= 1'b1;
        end

        do @(posedge vif.aclk);
        while (!(vif.awvalid && vif.awready));

        start_addr = vif.awaddr;
        burst_len  = vif.awlen;
        burst_size = vif.awsize;
        request_id = vif.awid;

        vif.awready <= 1'b0;

        write_burst_count++;

        if (!first_write_seen) begin
            first_write_addr = start_addr;
            first_write_seen = 1'b1;
        end

        if (vif.awburst != 2'b01) begin
            write_error_seen = 1'b1;
            `uvm_error("AXI_MEM_AW",
                $sformatf("Unsupported AWBURST=%0b ADDR=%016h",
                          vif.awburst, start_addr))
        end

        if (burst_size > 3) begin
            write_error_seen = 1'b1;
            `uvm_error("AXI_MEM_AW",
                $sformatf("Invalid AWSIZE=%0d for 64-bit AXI data bus",
                          burst_size))
        end

        beat_count     = burst_len + 1;
        bytes_per_beat = 1 << burst_size;

        `uvm_info("AXI_MEM_AW",
            $sformatf(
                "ADDR=%016h AWLEN=%0d BEATS=%0d AWSIZE=%0d BYTES_PER_BEAT=%0d",
                start_addr,
                burst_len,
                beat_count,
                burst_size,
                bytes_per_beat),
            UVM_LOW)

        for (int unsigned beat_index = 0;
             beat_index < beat_count;
             beat_index++) begin

            beat_addr = start_addr + (beat_index * bytes_per_beat);

            if (backpressure_enable) begin

                vif.wready <= 1'b0;

                // Apply backpressure to every write-data beat after WVALID.
                do @(posedge vif.aclk);
                while (vif.wvalid !== 1'b1);

                repeat (wready_delay_cycles)
                    @(posedge vif.aclk);

                vif.wready <= 1'b1;

            end
            else begin
                vif.wready <= 1'b1;
            end

            do @(posedge vif.aclk);
            while (!(vif.wvalid && vif.wready));

            vif.wready <= 1'b0;

            for (int unsigned byte_lane = 0;
                 byte_lane < 8;
                 byte_lane++) begin

                // WSTRB determines exactly which memory byte lanes are updated.
                if (vif.wstrb[byte_lane]) begin
                    mem[beat_addr + byte_lane] =
                        vif.wdata[(byte_lane*8) +: 8];

                    write_byte_count++;
                end
            end

            write_beat_count++;

            `uvm_info("AXI_MEM_W",
                $sformatf(
                    "BEAT=%0d ADDR=%016h DATA=%016h WSTRB=%02h WLAST=%0b",
                    beat_index,
                    beat_addr,
                    vif.wdata,
                    vif.wstrb,
                    vif.wlast),
                UVM_LOW)

            if ((beat_index == beat_count-1) && !vif.wlast) begin
                write_error_seen = 1'b1;
                `uvm_error("AXI_MEM_W",
                    "Expected WLAST on final AXI write beat")
            end

            if ((beat_index != beat_count-1) && vif.wlast) begin
                write_error_seen = 1'b1;
                `uvm_error("AXI_MEM_W",
                    $sformatf(
                        "Unexpected WLAST on write beat %0d of %0d",
                        beat_index,
                        beat_count))
            end
        end

        vif.wready <= 1'b0;

        // Return one OKAY write response after the complete burst is stored.
        if (backpressure_enable) begin
            repeat (bvalid_delay_cycles)
                @(posedge vif.aclk);
        end

        vif.bid    <= request_id;
        vif.bresp  <= 2'b00;
        vif.bvalid <= 1'b1;

        do @(posedge vif.aclk);
        while (!vif.bready);

        `uvm_info("AXI_MEM_B",
            $sformatf("BID=%0h BRESP=OKAY", request_id),
            UVM_LOW)

        vif.bvalid <= 1'b0;
    endtask

endclass

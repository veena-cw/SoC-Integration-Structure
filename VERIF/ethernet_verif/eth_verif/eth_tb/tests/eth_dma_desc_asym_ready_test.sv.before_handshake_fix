class eth_dma_desc_asym_ready_test extends eth_base_test;
    `uvm_component_utils(eth_dma_desc_asym_ready_test)

    virtual eth_desc_debug_if desc_vif;

    function new(
        string name = "eth_dma_desc_asym_ready_test",
        uvm_component parent = null
    );
        super.new(name, parent);
    endfunction

    function void build_phase(uvm_phase phase);
        super.build_phase(phase);

        if (!uvm_config_db#(virtual eth_desc_debug_if)::get(
                this,
                "",
                "desc_debug_vif",
                desc_vif
            ))
            `uvm_fatal(
                "DESC_ASYM",
                "desc_debug_vif not found"
            )
    endfunction

    task automatic print_state(string label);
        `uvm_info(
            "DESC_ASYM",
            $sformatf(
                "%s CFG_VALID=%0b CFG_READY=%0b RD_VALID=%0b RD_READY=%0b WR_VALID=%0b WR_READY=%0b",
                label,
                desc_vif.cfg_valid,
                desc_vif.cfg_ready,
                desc_vif.rd_valid,
                desc_vif.rd_ready,
                desc_vif.wr_valid,
                desc_vif.wr_ready
            ),
            UVM_LOW
        )
    endtask

    task run_phase(uvm_phase phase);

        eth_reset_seq               reset_sequence;
        eth_parallel_dma_config_seq config_sequence;
        eth_parallel_dma_start_seq  start_sequence;

        bit cfg_dropped;
        bit rx_descriptor_lost;

        phase.raise_objection(this);

        `uvm_info(
            "DESC_ASYM",
            "CASE_A: TX descriptor ready, RX descriptor forced not-ready",
            UVM_LOW
        )

        desc_vif.force_rd_not_ready = 1'b0;
        desc_vif.force_wr_not_ready = 1'b0;

        /*
         * Reset exactly as the existing working tests do.
         */
        reset_sequence =
            eth_reset_seq::type_id::create("reset_sequence");

        reset_sequence.start(env.reset_ag.sqr);

        repeat (5)
            @(posedge desc_vif.clk);

        /*
         * Program TX/RX descriptor configuration only.
         * This sequence does NOT perform the DMA_CTRL commit.
         */
        config_sequence =
            eth_parallel_dma_config_seq::type_id::create(
                "config_sequence"
            );

        config_sequence.start(env.axil_ag.sqr);

        repeat (3)
            @(posedge desc_vif.clk);

        /*
         * Artificial asymmetric condition:
         *
         * TX consumer  : allowed to be READY
         * RX consumer  : forced NOT READY
         */
        desc_vif.force_wr_not_ready = 1'b1;

        repeat (3)
            @(posedge desc_vif.clk);

        print_state("BEFORE_COMMIT");

        /*
         * Commit DMA_CTRL = 3 using the existing proven sequence.
         */
        start_sequence =
            eth_parallel_dma_start_seq::type_id::create(
                "start_sequence"
            );

        fork
            begin
                start_sequence.start(env.axil_ag.sqr);
            end
        join_none

        /*
         * Wait for the committed configuration to become valid.
         */
        fork
            begin : wait_cfg_valid
                wait (desc_vif.cfg_valid === 1'b1);
            end

            begin : cfg_valid_timeout
                repeat (100)
                    @(posedge desc_vif.clk);

                if (desc_vif.cfg_valid !== 1'b1)
                    `uvm_fatal(
                        "DESC_ASYM_TIMEOUT",
                        "Timeout waiting for CFG_VALID"
                    )
            end
        join_any

        disable fork;

        #1ps;

        print_state("CONFIG_PRESENT");

        /*
         * Confirm that the intended asymmetric condition really exists.
         */
        if (desc_vif.cfg_valid !== 1'b1)
            `uvm_error(
                "DESC_ASYM_SETUP",
                "CFG_VALID was not asserted"
            )

        if (desc_vif.rd_valid !== 1'b1)
            `uvm_error(
                "DESC_ASYM_SETUP",
                "RD_VALID was not asserted"
            )

        if (desc_vif.rd_ready !== 1'b1)
            `uvm_error(
                "DESC_ASYM_SETUP",
                "RD_READY was not asserted"
            )

        if (desc_vif.wr_valid !== 1'b1)
            `uvm_error(
                "DESC_ASYM_SETUP",
                "WR_VALID was not asserted"
            )

        if (desc_vif.wr_ready !== 1'b0)
            `uvm_error(
                "DESC_ASYM_SETUP",
                "WR_READY was not held low"
            )

        if (desc_vif.cfg_ready !== 1'b1)
            `uvm_error(
                "DESC_ASYM_SETUP",
                "CFG_READY was not asserted while TX was ready"
            )

        /*
         * Allow the TX descriptor handshake cycle to complete.
         */
        @(posedge desc_vif.clk);
        #1ps;

        print_state("AFTER_TX_HANDSHAKE");

        cfg_dropped =
            (desc_vif.cfg_valid === 1'b0);

        /*
         * RX becomes ready only after the TX side has already had the
         * opportunity to acknowledge the shared configuration.
         */
        desc_vif.force_wr_not_ready = 1'b0;

        repeat (10)
            @(posedge desc_vif.clk);

        #1ps;

        print_state("AFTER_RX_RELEASE");

        /*
         * Failure signature:
         *
         * 1. Shared CFG_VALID disappeared after TX accepted.
         * 2. RX later becomes READY.
         * 3. WR_VALID is no longer present.
         *
         * Therefore RX never receives the committed descriptor.
         */
        rx_descriptor_lost =
            cfg_dropped &&
            (desc_vif.wr_ready === 1'b1) &&
            (desc_vif.wr_valid === 1'b0);

        if (rx_descriptor_lost) begin

            `uvm_error(
                "DESC_ASYM_LOST_RX",
                {"CASE_A reproduced lost RX descriptor: ",
                 "TX accepted the shared configuration while RX was not ready; ",
                 "after RX became ready, WR_VALID was no longer asserted"}
            )

        end
        else begin

            `uvm_info(
                "DESC_ASYM_RESULT",
                "CASE_A did not reproduce the suspected lost RX descriptor",
                UVM_LOW
            )

        end

        desc_vif.force_rd_not_ready = 1'b0;
        desc_vif.force_wr_not_ready = 1'b0;

        repeat (5)
            @(posedge desc_vif.clk);

        phase.drop_objection(this);

    endtask

endclass

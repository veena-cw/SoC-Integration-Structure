
class eth_rx_fifo_random_backpressure_test
    extends eth_rx_fifo_concurrent_drain_test;

    `uvm_component_utils(eth_rx_fifo_random_backpressure_test)

    localparam int unsigned ITERATIONS = 2;
    localparam int unsigned RETAINED = 8;
    localparam int unsigned FRAME_BYTES = 1024;
    localparam bit [31:0] RANDOM_DMA_BASE = 32'h0080_0000;

    int unsigned iteration_passes;
    int unsigned random_release_delay;

    function new(
        string name = "eth_rx_fifo_random_backpressure_test",
        uvm_component parent = null
    );
        super.new(name, parent);
    endfunction

    task automatic random_program_dma(input int unsigned index);
        eth_rx_only_dma_seq cfg;

        cfg = eth_rx_only_dma_seq::type_id::create(
            $sformatf("random_cfg_%0d", index)
        );

        cfg.rx_base = RANDOM_DMA_BASE + index * 32'h1000;
        cfg.rx_length = FRAME_BYTES;
        cfg.start(env.axil_ag.sqr);
    endtask

    task automatic random_check_dma(
        input int unsigned index,
        input int unsigned frame_id
    );
        bit [31:0] addr;
        byte unsigned actual;
        byte unsigned expected;

        for (int unsigned i = 0; i < FRAME_BYTES; i++) begin
            addr = RANDOM_DMA_BASE + index * 32'h1000 + i;
            expected = payload_byte(frame_id, i);

            if (!env.axi_ag.drv.mem.exists(addr)) begin
                fail(
                    "RANDOM_DMA_MISSING",
                    $sformatf(
                        "frame=%0d offset=%0d address=%08h missing",
                        frame_id, i, addr
                    )
                );
                return;
            end

            actual = env.axi_ag.drv.mem[addr];

            if (actual !== expected) begin
                fail(
                    "RANDOM_DMA_MISMATCH",
                    $sformatf(
                        "frame=%0d offset=%0d got=%02h expected=%02h",
                        frame_id, i, actual, expected
                    )
                );
                return;
            end
        end

        `uvm_info(
            "RANDOM_DMA_MATCH",
            $sformatf(
                "frame=%0d all %0d bytes matched",
                frame_id, FRAME_BYTES
            ),
            UVM_NONE
        )
    endtask

    task automatic wait_for_completions(input int unsigned target);
        int unsigned timeout_cycles;

        timeout_cycles = 0;

        while (completed_count < target && timeout_cycles < 100000) begin
            @(posedge desc_vif.clk);
            timeout_cycles++;
        end

        if (completed_count != target)
            fail(
                "RANDOM_COMPLETION_TIMEOUT",
                $sformatf(
                    "completed=%0d expected=%0d",
                    completed_count, target
                )
            );
    endtask

    task run_phase(uvm_phase phase);
        int unsigned dma_index;
        int unsigned frame_id;
        int unsigned before_good;
        int unsigned before_drop;
        int unsigned before_end;
        int unsigned before_overflow;
        int unsigned before_rollback;
        int unsigned before_overlap;
        int unsigned before_nonfull;
        int unsigned before_ram;
        int unsigned before_write;
        int unsigned expected_completions;
        int unsigned wait_cycles;

        phase.raise_objection(this);

        rgmii_vif.loopback_enable = 1'b0;
        desc_vif.force_wr_not_ready = 1'b0;
        iteration_passes = 0;

        begin
            eth_reset_seq rst;
            rst = eth_reset_seq::type_id::create("random_reset");
            rst.start(env.reset_ag.sqr);
        end

        repeat (30) @(posedge desc_vif.clk);

        fork
            observe();
            check_drop_pointer();
            check_drop_ram();
            check_write_suppression();
        join_none

        for (int unsigned iteration = 0;
             iteration < ITERATIONS;
             iteration++) begin

            before_good = good_count;
            before_drop = drop_started;
            before_end = drop_ended;
            before_overflow = overflow_pulses;
            before_rollback = rollback_checks;
            before_overlap = overlap_beats;
            before_nonfull = full_cleared_during_drop;
            before_ram = ram_checks;
            before_write = write_suppression_checks;

            desc_vif.force_wr_not_ready = 1'b1;
            drain_enabled = 0;
            drop_seen = 0;
            dropped_frame_done = 0;

            for (int unsigned j = 0; j < RETAINED; j++) begin
                frame_id = 100 + iteration * 20 + j;
                drive_frame(frame_id);
                send_ifg();
            end

            wait_cycles = 0;
            while (good_count < before_good + RETAINED &&
                   wait_cycles < 2000) begin
                @(posedge desc_vif.clk);
                wait_cycles++;
            end

            if (good_count != before_good + RETAINED)
                fail(
                    "RANDOM_PREFILL",
                    $sformatf(
                        "iteration=%0d good_before=%0d good_after=%0d expected=%0d",
                        iteration,
                        before_good,
                        good_count,
                        before_good + RETAINED
                    )
                );

            random_release_delay = $urandom_range(0, 12);

            fork
                begin : dropped_frame
                    drive_frame(100 + iteration * 20 + RETAINED);
                    dropped_frame_done = 1;
                    send_ifg();
                end

                begin : release_dma
                    wait_cycles = 0;

                    while (drop_started == before_drop &&
                           wait_cycles < 20000) begin
                        @(posedge desc_vif.rx_fifo_src_clk);
                        wait_cycles++;
                    end

                    if (drop_started == before_drop)
                        fail("RANDOM_NO_DROP", "No drop detected");
                    else begin
                        repeat (random_release_delay)
                            @(posedge desc_vif.rx_fifo_src_clk);

                        @(negedge desc_vif.clk);
                        drain_enabled = 1;
                        desc_vif.force_wr_not_ready = 1'b0;
                    end

                    for (int unsigned j = 0; j < RETAINED; j++) begin
                        dma_index = iteration * (RETAINED + 1) + j;
                        random_program_dma(dma_index);
                    end
                end
            join

            expected_completions =
                (iteration + 1) * RETAINED + iteration;

            wait_for_completions(expected_completions);

            repeat (100) @(posedge desc_vif.clk);

            for (int unsigned j = 0; j < RETAINED; j++) begin
                random_check_dma(
                    iteration * (RETAINED + 1) + j,
                    100 + iteration * 20 + j
                );
            end

            if (drop_started != before_drop + 1 ||
                drop_ended != before_end + 1 ||
                overflow_pulses != before_overflow + 1 ||
                rollback_checks != before_rollback + 1)
                fail(
                    "RANDOM_DROP_COVERAGE",
                    $sformatf(
                        "iteration=%0d drop_start=%0d drop_end=%0d overflow=%0d rollback=%0d",
                        iteration,
                        drop_started - before_drop,
                        drop_ended - before_end,
                        overflow_pulses - before_overflow,
                        rollback_checks - before_rollback
                    )
                );

            if (overlap_beats <= before_overlap ||
                full_cleared_during_drop <= before_nonfull ||
                ram_checks <= before_ram ||
                write_suppression_checks <= before_write)
                fail(
                    "RANDOM_MONITOR_COVERAGE",
                    $sformatf("iteration=%0d missing monitor coverage",
                              iteration)
                );

            random_program_dma(
                iteration * (RETAINED + 1) + RETAINED
            );

            drive_frame(100 + iteration * 20 + RETAINED + 1);

            wait_for_completions(expected_completions + 1);

            random_check_dma(
                iteration * (RETAINED + 1) + RETAINED,
                100 + iteration * 20 + RETAINED + 1
            );

            if (errors_seen == 0)
                iteration_passes++;

            `uvm_info(
                "RANDOM_ITERATION",
                $sformatf(
                    "iteration=%0d release_delay=%0d passes=%0d",
                    iteration,
                    random_release_delay,
                    iteration_passes
                ),
                UVM_NONE
            )
        end

        desc_vif.force_wr_not_ready = 1'b0;

        if (iteration_passes == ITERATIONS && errors_seen == 0)
            `uvm_info(
                "RANDOM_BACKPRESSURE_PASS",
                $sformatf(
                    "iterations=%0d completed=%0d overflow=%0d rollback=%0d errors=%0d",
                    iteration_passes,
                    completed_count,
                    overflow_pulses,
                    rollback_checks,
                    errors_seen
                ),
                UVM_NONE
            )
        else
            fail(
                "RANDOM_BACKPRESSURE_FAIL",
                $sformatf(
                    "passes=%0d expected=%0d errors=%0d",
                    iteration_passes, ITERATIONS, errors_seen
                )
            );

        phase.drop_objection(this);
    endtask

endclass

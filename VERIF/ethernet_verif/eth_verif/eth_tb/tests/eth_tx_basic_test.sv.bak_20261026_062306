class eth_irq001_csr_seq extends uvm_sequence #(eth_axil_item);
    `uvm_object_utils(eth_irq001_csr_seq)

    bit [31:0] status_before;
    bit [31:0] status_after;
    bit failed;

    function new(string name = "eth_irq001_csr_seq");
        super.new(name);
    endfunction

    task automatic access_reg(
        input bit write_access,
        input bit [31:0] address,
        inout bit [31:0] data_value
    );
        eth_axil_item item;

        item = eth_axil_item::type_id::create("irq001_item");
        start_item(item);
        item.write = write_access;
        item.addr  = address;
        item.data  = data_value;
        item.strb  = 4'hF;
        finish_item(item);

        if (item.resp !== 2'b00) begin
            failed = 1'b1;
            `uvm_error("IRQ001_AXIL",
                $sformatf("AXI-Lite response failure ADDR=%08h RESP=%02b",
                          address, item.resp))
        end

        if (!write_access)
            data_value = item.data;
    endtask

    task body();
        bit [31:0] value;

        failed = 1'b0;

        value = 32'h0;
        access_reg(1'b0, 32'h0000_000C, value);
        status_before = value;

        if (status_before[2:0] !== 3'b001) begin
            failed = 1'b1;
            `uvm_error("IRQ001_STATUS",
                $sformatf("Before clear: expected 001, got %03b",
                          status_before[2:0]))
        end
        else
            `uvm_info("IRQ001_PASS",
                "INT_STATUS before clear = 001", UVM_LOW)

        if (failed)
            return;

        value = 32'h0000_0001;
        access_reg(1'b1, 32'h0000_000C, value);

        value = 32'h0;
        access_reg(1'b0, 32'h0000_000C, value);
        status_after = value;

        if (status_after[2:0] !== 3'b000) begin
            failed = 1'b1;
            `uvm_error("IRQ001_W1C",
                $sformatf("After clear: expected 000, got %03b",
                          status_after[2:0]))
        end
        else
            `uvm_info("IRQ001_PASS",
                "W1C cleared INT_STATUS to 000", UVM_LOW)
    endtask
endclass

class eth_tx_basic_test extends eth_base_test;                                             // Verifies TX DMA memory reads and the complete byte stream delivered to the MAC.

    `uvm_component_utils(eth_tx_basic_test)                                                // Registers the TX basic test with the UVM factory.

    function new(string name, uvm_component parent);                                      // Constructs the directed TX DMA test.
        super.new(name, parent);                                                          // Initializes the inherited base-test state.
    endfunction


    function automatic logic [31:0] calculate_ethernet_fcs(input byte unsigned frame_bytes[$]); // Calculates Ethernet CRC-32 across the transmitted frame bytes.
        logic [31:0] crc;                                                                         // Holds the running reflected Ethernet CRC value.
        logic        feedback;                                                                    // Holds the XOR result used for each CRC bit iteration.

        crc = 32'hFFFF_FFFF;                                                                      // Initializes Ethernet CRC-32 to all ones.

        foreach (frame_bytes[byte_index]) begin                                                    // Processes every frame byte in transmitted byte order.
            for (int unsigned bit_index = 0; bit_index < 8; bit_index++) begin                     // Processes each byte least-significant bit first.
                feedback = crc[0] ^ frame_bytes[byte_index][bit_index];                            // Combines the current data bit with the reflected CRC feedback bit.
                crc = crc >> 1;                                                                   // Shifts the reflected CRC state toward the least-significant bit.
                if (feedback) begin                                                               // Applies the reflected Ethernet polynomial when feedback is asserted.
                    crc = crc ^ 32'hEDB8_8320;                                                     // Updates the CRC with the reflected Ethernet polynomial.
                end                                                                               // Ends conditional polynomial application.
            end                                                                                   // Ends processing of one byte's eight bits.
        end                                                                                       // Ends processing of all frame bytes.

        return ~crc;                                                                               // Returns the final complemented Ethernet CRC-32 value.
    endfunction

    virtual eth_irq_if irq_vif;

    function void build_phase(uvm_phase phase);
        super.build_phase(phase);
        if (!uvm_config_db#(virtual eth_irq_if)::get(
                this, "", "vif", irq_vif))
            `uvm_fatal("IRQ001_NOVIF", "IRQ interface unavailable")
    endfunction

    task run_phase(uvm_phase phase);                                                      // Executes reset, DMA programming, AXI checks, and MAC-input AXIS checks.

        eth_reset_seq  reset_seq;                                                         // Holds the reset sequence used before TX DMA programming.
        eth_tx_dma_seq tx_dma_seq;
        eth_irq001_csr_seq irq001_seq;
        int unsigned irq001_timeout;
        bit irq001_failed;
                                                        // Holds the sequence that programs and starts TX DMA.
        int unsigned   timeout_cycles;                                                    // Counts cycles while waiting for a verification condition.
        int unsigned   axis_byte_errors;
        int unsigned   rgmii_timeout_cycles;                                              // Counts cycles while waiting for the external RGMII frame to complete.
        int unsigned   rgmii_byte_errors;                                                 // Counts RGMII preamble, SFD, payload, and FCS mismatches.
        byte unsigned  expected_frame_bytes[$];                                           // Stores the 64 frame bytes used to calculate the expected Ethernet FCS.
        logic [31:0]    expected_fcs;                                                      // Holds the calculated Ethernet CRC-32 value for the transmitted frame.                                                  // Counts byte mismatches detected on the MAC-input AXI-Stream.

        phase.raise_objection(this);

        `uvm_info("ETH_TX_BASIC",
                  "Starting directed TX DMA through MAC-input AXI-Stream verification",
                  UVM_LOW)

        reset_seq = eth_reset_seq::type_id::create("reset_seq");                          // Creates the DUT reset sequence.
        reset_seq.start(env.reset_ag.sqr);                                                // Applies reset through the reset agent.

        for (int unsigned i = 0; i < 64; i++) begin                                      // Initializes exactly 64 source bytes for the TX DMA transfer.
            env.axi_ag.drv.mem[64'h0000_0000_0000_1000 + i] = i[7:0];                    // Stores byte pattern 00 through 3F at addresses 0x1000 through 0x103F.
        end

        `uvm_info("ETH_TX_BASIC",
                  "Preloaded 64 bytes at AXI memory address 0x0000000000001000",
                  UVM_LOW)

        tx_dma_seq = eth_tx_dma_seq::type_id::create("tx_dma_seq");                       // Creates the TX DMA register-programming sequence.
        `uvm_info("TX_DEBUG",
                  "Starting TX DMA AXI-Lite configuration",
                  UVM_LOW)

        tx_dma_seq.start(env.axil_ag.sqr);

        `uvm_info("TX_DEBUG",
                  "TX DMA AXI-Lite configuration completed",
                  UVM_LOW)                                                // Programs TX base/length and commits DMA_CTRL through AXI4-Lite.

        timeout_cycles = 0;                                                               // Starts the AXI-memory-read completion timeout counter.

        while ((env.axi_ag.drv.read_byte_count < 64) && (timeout_cycles < 2000)) begin    // Waits for the complete 64-byte DMA memory read.
            @(posedge env.axi_ag.drv.vif.aclk);                                           // Advances one AXI memory clock cycle.
            timeout_cycles++;                                                             // Records one additional cycle spent waiting for the DMA read.
        end

        if (!env.axi_ag.drv.first_read_seen) begin                                        // Checks that the TX DMA generated an AXI read request.
            `uvm_error("TX_DMA_CHECK",
                       "No AXI read request was generated by the TX DMA")
        end
        else begin                                                                        // Checks the address after confirming that an AXI read occurred.

            if (env.axi_ag.drv.first_read_addr != 64'h0000_0000_0000_1000) begin         // Compares the first DMA read address with the programmed source address.
                `uvm_error("TX_DMA_CHECK",
                           $sformatf("First read address mismatch EXP=%016h GOT=%016h",
                                     64'h0000_0000_0000_1000,
                                     env.axi_ag.drv.first_read_addr))
            end
            else begin                                                                    // Reports successful verification of the DMA source address.
                `uvm_info("TX_DMA_CHECK",
                          $sformatf("PASS first AXI read address = %016h",
                                    env.axi_ag.drv.first_read_addr),
                          UVM_LOW)
            end

        end

        if (env.axi_ag.drv.read_byte_count != 64) begin                                   // Checks that exactly 64 source bytes were returned to the DMA.
            `uvm_error("TX_DMA_CHECK",
                       $sformatf("DMA read byte count mismatch EXP=64 GOT=%0d",
                                 env.axi_ag.drv.read_byte_count))
        end
        else begin                                                                        // Reports successful verification of the AXI read transfer length.
            `uvm_info("TX_DMA_CHECK",
                      "PASS DMA read byte count = 64",
                      UVM_LOW)
        end

        if (env.axi_ag.drv.read_error_seen) begin                                         // Checks whether the AXI memory model detected an invalid read request.
            `uvm_error("TX_DMA_CHECK",
                       "AXI memory model detected an invalid DMA read request")
        end
        else begin                                                                        // Reports that the observed AXI read transaction satisfied the protocol checks.
            `uvm_info("TX_DMA_CHECK",
                      "PASS no AXI read protocol error detected",
                      UVM_LOW)
        end

        `uvm_info("TX_DMA_CHECK",
                  $sformatf("SUMMARY bursts=%0d beats=%0d bytes=%0d first_addr=%016h",
                            env.axi_ag.drv.read_burst_count,
                            env.axi_ag.drv.read_beat_count,
                            env.axi_ag.drv.read_byte_count,
                            env.axi_ag.drv.first_read_addr),
                  UVM_LOW)

        timeout_cycles = 0;                                                               // Restarts the timeout counter for MAC-input AXI-Stream completion.

        while ((env.tx_axis_mon.transfer_count < 64) && (timeout_cycles < 2000)) begin    // Waits until all 64 bytes have been accepted by the MAC.
            @(posedge env.tx_axis_mon.vif.aclk);                                          // Advances one MAC-input AXI-Stream clock cycle.
            timeout_cycles++;                                                             // Records one additional cycle spent waiting for AXIS completion.
        end

        if (env.tx_axis_mon.transfer_count != 64) begin                                   // Detects a missing, stalled, or incomplete DMA-to-MAC transfer.
            `uvm_error("TX_AXIS_CHECK",
                       $sformatf("TX AXIS byte count mismatch EXP=64 GOT=%0d",
                                 env.tx_axis_mon.transfer_count))
        end
        else begin                                                                        // Reports that the complete frame reached the MAC input.
            `uvm_info("TX_AXIS_CHECK",
                      "PASS TX AXIS byte count = 64",
                      UVM_LOW)
        end

        axis_byte_errors = 0;                                                             // Clears the payload mismatch counter before comparing captured bytes.

        if (env.tx_axis_mon.observed_bytes.size() == 64) begin                            // Performs byte comparison only when a complete 64-byte frame was captured.

            for (int unsigned i = 0; i < 64; i++) begin                                  // Compares every accepted MAC-input byte with the source-memory pattern.

                if (env.tx_axis_mon.observed_bytes[i] !== i[7:0]) begin                   // Detects corruption, loss, duplication, or incorrect byte ordering.
                    axis_byte_errors++;                                                   // Counts this AXIS payload mismatch.
                    `uvm_error("TX_AXIS_DATA",
                               $sformatf("Byte mismatch INDEX=%0d EXP=%02h GOT=%02h",
                                         i,
                                         i[7:0],
                                         env.tx_axis_mon.observed_bytes[i]))
                end

            end

            if (axis_byte_errors == 0) begin                                              // Reports success only when all 64 captured bytes match.
                `uvm_info("TX_AXIS_DATA",
                          "PASS TX AXIS payload matches expected bytes 00 through 3F",
                          UVM_LOW)
            end

        end
        else begin                                                                        // Reports that payload comparison cannot complete because the frame was incomplete.
            `uvm_error("TX_AXIS_DATA",
                       $sformatf("Cannot verify complete payload because only %0d bytes were captured",
                                 env.tx_axis_mon.observed_bytes.size()))
        end

        if (env.tx_axis_mon.tlast_count != 1) begin                                       // Checks that exactly one frame-end indication was observed.
            `uvm_error("TX_AXIS_TLAST",
                       $sformatf("TLAST count mismatch EXP=1 GOT=%0d",
                                 env.tx_axis_mon.tlast_count))
        end
        else if (env.tx_axis_mon.tlast_index != 63) begin                                 // Checks that TLAST accompanied the 64th byte of the frame.
            `uvm_error("TX_AXIS_TLAST",
                       $sformatf("TLAST position mismatch EXP=63 GOT=%0d",
                                 env.tx_axis_mon.tlast_index))
        end
        else begin                                                                        // Reports correct frame termination at byte index 63.
            `uvm_info("TX_AXIS_TLAST",
                      "PASS TLAST observed exactly once at byte index 63",
                      UVM_LOW)
        end

        if (env.tx_axis_mon.tuser_seen) begin                                             // Detects any TX user/error indication asserted on an accepted transfer.
            `uvm_error("TX_AXIS_TUSER",
                       "TUSER was asserted during the directed TX frame")
        end
        else begin                                                                        // Reports that the complete frame transferred without a TUSER error indication.
            `uvm_info("TX_AXIS_TUSER",
                      "PASS TUSER remained deasserted for the complete TX frame",
                      UVM_LOW)
        end

        `uvm_info("TX_AXIS_CHECK",
                  $sformatf("SUMMARY bytes=%0d stored=%0d tlast_count=%0d tlast_index=%0d tuser_seen=%0b byte_errors=%0d",
                            env.tx_axis_mon.transfer_count,
                            env.tx_axis_mon.observed_bytes.size(),
                            env.tx_axis_mon.tlast_count,
                            env.tx_axis_mon.tlast_index,
                            env.tx_axis_mon.tuser_seen,
                            axis_byte_errors),
                  UVM_LOW)



        rgmii_timeout_cycles = 0;                                                         // Starts the timeout used while waiting for the external RGMII frame.

        while (((env.rgmii_ag.mon.tx_frame_count < 1) || env.rgmii_ag.mon.tx_frame_active) && (rgmii_timeout_cycles < 2000)) begin // Waits until one complete external RGMII frame has been observed.
            @(posedge env.tx_axis_mon.vif.aclk);                                          // Advances one test clock cycle while waiting for RGMII frame completion.
            rgmii_timeout_cycles++;                                                       // Counts one additional cycle spent waiting for the RGMII frame.
        end

        if (rgmii_timeout_cycles >= 2000) begin                                           // Detects failure to observe a complete RGMII frame before timeout.
            `uvm_error("RGMII_CHECK", $sformatf("Timeout waiting for complete RGMII frame frames=%0d active=%0b bytes=%0d", env.rgmii_ag.mon.tx_frame_count, env.rgmii_ag.mon.tx_frame_active, env.rgmii_ag.mon.tx_byte_count))
        end

        if (env.rgmii_ag.mon.tx_frame_count != 1) begin                                   // Checks that exactly one RGMII frame was transmitted.
            `uvm_error("RGMII_FRAME_CHECK", $sformatf("RGMII frame count mismatch EXP=1 GOT=%0d", env.rgmii_ag.mon.tx_frame_count))
        end
        else begin                                                                        // Handles the expected single-frame result.
            `uvm_info("RGMII_FRAME_CHECK", "PASS exactly one RGMII TX frame observed", UVM_LOW)
        end

        if (env.rgmii_ag.mon.tx_byte_count != 76) begin                                   // Checks seven preamble bytes, one SFD, 64 frame bytes, and four FCS bytes.
            `uvm_error("RGMII_LENGTH_CHECK", $sformatf("RGMII byte count mismatch EXP=76 GOT=%0d", env.rgmii_ag.mon.tx_byte_count))
        end
        else begin                                                                        // Handles the expected 76-byte external frame.
            `uvm_info("RGMII_LENGTH_CHECK", "PASS RGMII byte count = 76", UVM_LOW)
        end

        rgmii_byte_errors = 0;                                                            // Clears the RGMII content mismatch counter.

        if (env.rgmii_ag.mon.tx_bytes.size() >= 8) begin                                  // Confirms enough bytes exist for the Ethernet preamble and SFD checks.
            for (int unsigned i = 0; i < 7; i++) begin                                   // Checks each of the seven Ethernet preamble bytes.
                if (env.rgmii_ag.mon.tx_bytes[i] !== 8'h55) begin                         // Detects an incorrect preamble byte.
                    rgmii_byte_errors++;                                                  // Counts the incorrect preamble byte.
                    `uvm_error("RGMII_PREAMBLE_CHECK", $sformatf("Preamble mismatch INDEX=%0d EXP=55 GOT=%02h", i, env.rgmii_ag.mon.tx_bytes[i]))
                end                                                                       // Ends one preamble-byte mismatch check.
            end                                                                           // Ends checking all seven preamble bytes.

            if (env.rgmii_ag.mon.tx_bytes[7] !== 8'hD5) begin                             // Checks the Ethernet start-frame delimiter.
                rgmii_byte_errors++;                                                      // Counts an incorrect SFD.
                `uvm_error("RGMII_SFD_CHECK", $sformatf("SFD mismatch INDEX=7 EXP=D5 GOT=%02h", env.rgmii_ag.mon.tx_bytes[7]))
            end
        end                                                                               // Ends preamble and SFD checking.
        else begin                                                                        // Handles an RGMII capture shorter than the preamble and SFD.
            rgmii_byte_errors++;                                                          // Records the incomplete preamble/SFD capture as a content error.
            `uvm_error("RGMII_PREAMBLE_CHECK", $sformatf("Insufficient RGMII bytes for preamble/SFD check GOT=%0d", env.rgmii_ag.mon.tx_bytes.size()))
        end

        if ((env.rgmii_ag.mon.tx_bytes.size() >= 8) && (rgmii_byte_errors == 0)) begin    // Reports correct Ethernet preamble and SFD contents.
            `uvm_info("RGMII_PREAMBLE_CHECK", "PASS preamble = 55 55 55 55 55 55 55 and SFD = D5", UVM_LOW)
        end

        if (env.rgmii_ag.mon.tx_bytes.size() >= 72) begin                                 // Confirms all 64 frame bytes are present after preamble and SFD.
            for (int unsigned i = 0; i < 64; i++) begin                                  // Checks every transmitted frame byte.
                if (env.rgmii_ag.mon.tx_bytes[8+i] !== i[7:0]) begin                      // Detects corruption or reordering in the MAC-to-RGMII path.
                    rgmii_byte_errors++;                                                  // Counts the incorrect frame byte.
                    `uvm_error("RGMII_PAYLOAD_CHECK", $sformatf("Payload mismatch FRAME_INDEX=%0d RGMII_INDEX=%0d EXP=%02h GOT=%02h", i, 8+i, i[7:0], env.rgmii_ag.mon.tx_bytes[8+i]))
                end                                                                       // Ends one payload-byte mismatch check.
            end                                                                           // Ends checking all 64 transmitted frame bytes.
        end                                                                               // Ends complete payload checking.
        else begin                                                                        // Handles an RGMII capture shorter than the complete frame data.
            rgmii_byte_errors++;                                                          // Records the incomplete payload capture as a content error.
            `uvm_error("RGMII_PAYLOAD_CHECK", $sformatf("Insufficient RGMII bytes for 64-byte payload check GOT=%0d", env.rgmii_ag.mon.tx_bytes.size()))
        end

        expected_frame_bytes.delete();                                                    // Clears the expected frame queue before constructing the CRC input.

        for (int unsigned i = 0; i < 64; i++) begin                                      // Builds the exact 64-byte frame supplied to the MAC.
            expected_frame_bytes.push_back(i[7:0]);                                       // Adds bytes 00 through 3F in transmitted order.
        end                                                                               // Ends construction of the expected CRC input frame.

        expected_fcs = calculate_ethernet_fcs(expected_frame_bytes);                      // Calculates Ethernet CRC-32 across the 64 transmitted frame bytes.

        `uvm_info("RGMII_FCS_CHECK", $sformatf("Calculated expected Ethernet FCS = %08h", expected_fcs), UVM_LOW)

        if (env.rgmii_ag.mon.tx_bytes.size() >= 76) begin                                 // Confirms all four transmitted FCS bytes were captured.
            if (env.rgmii_ag.mon.tx_bytes[72] !== expected_fcs[7:0]) begin                // Checks the first transmitted FCS byte.
                rgmii_byte_errors++;                                                      // Counts an incorrect first FCS byte.
                `uvm_error("RGMII_FCS_CHECK", $sformatf("FCS byte 0 mismatch EXP=%02h GOT=%02h", expected_fcs[7:0], env.rgmii_ag.mon.tx_bytes[72]))
            end                                                                           // Ends first FCS-byte comparison.

            if (env.rgmii_ag.mon.tx_bytes[73] !== expected_fcs[15:8]) begin               // Checks the second transmitted FCS byte.
                rgmii_byte_errors++;                                                      // Counts an incorrect second FCS byte.
                `uvm_error("RGMII_FCS_CHECK", $sformatf("FCS byte 1 mismatch EXP=%02h GOT=%02h", expected_fcs[15:8], env.rgmii_ag.mon.tx_bytes[73]))
            end                                                                           // Ends second FCS-byte comparison.

            if (env.rgmii_ag.mon.tx_bytes[74] !== expected_fcs[23:16]) begin              // Checks the third transmitted FCS byte.
                rgmii_byte_errors++;                                                      // Counts an incorrect third FCS byte.
                `uvm_error("RGMII_FCS_CHECK", $sformatf("FCS byte 2 mismatch EXP=%02h GOT=%02h", expected_fcs[23:16], env.rgmii_ag.mon.tx_bytes[74]))
            end                                                                           // Ends third FCS-byte comparison.

            if (env.rgmii_ag.mon.tx_bytes[75] !== expected_fcs[31:24]) begin              // Checks the fourth transmitted FCS byte.
                rgmii_byte_errors++;                                                      // Counts an incorrect fourth FCS byte.
                `uvm_error("RGMII_FCS_CHECK", $sformatf("FCS byte 3 mismatch EXP=%02h GOT=%02h", expected_fcs[31:24], env.rgmii_ag.mon.tx_bytes[75]))
            end                                                                           // Ends fourth FCS-byte comparison.

            if ((env.rgmii_ag.mon.tx_bytes[72] === expected_fcs[7:0]) && (env.rgmii_ag.mon.tx_bytes[73] === expected_fcs[15:8]) && (env.rgmii_ag.mon.tx_bytes[74] === expected_fcs[23:16]) && (env.rgmii_ag.mon.tx_bytes[75] === expected_fcs[31:24])) begin // Confirms all transmitted FCS bytes match the calculated CRC.
                `uvm_info("RGMII_FCS_CHECK", $sformatf("PASS FCS bytes = %02h %02h %02h %02h", env.rgmii_ag.mon.tx_bytes[72], env.rgmii_ag.mon.tx_bytes[73], env.rgmii_ag.mon.tx_bytes[74], env.rgmii_ag.mon.tx_bytes[75]), UVM_LOW)
            end                                                                           // Ends successful FCS report.
        end                                                                               // Ends complete FCS checking.
        else begin                                                                        // Handles a capture that ended before all four FCS bytes.
            rgmii_byte_errors++;                                                          // Records the incomplete FCS capture as a content error.
            `uvm_error("RGMII_FCS_CHECK", $sformatf("Insufficient RGMII bytes for FCS check GOT=%0d", env.rgmii_ag.mon.tx_bytes.size()))
        end

        if (env.rgmii_ag.mon.tx_error_seen) begin                                         // Checks whether RGMII TX_ER was asserted anywhere in the frame.
            `uvm_error("RGMII_TXER_CHECK", "RGMII TX_ER was asserted during the transmitted frame")
        end
        else begin                                                                        // Handles an error-free RGMII control stream.
            `uvm_info("RGMII_TXER_CHECK", "PASS RGMII TX_ER remained deasserted", UVM_LOW)
        end

        if (rgmii_byte_errors == 0) begin                                                 // Reports complete Stage-5 frame-content success.
            `uvm_info("RGMII_CHECK", "PASS complete MAC-to-RGMII frame content verified", UVM_LOW)
        end
        else begin                                                                        // Handles one or more RGMII content mismatches.
            `uvm_error("RGMII_CHECK", $sformatf("MAC-to-RGMII frame verification failed with %0d content errors", rgmii_byte_errors))
        end

        `uvm_info("RGMII_CHECK", $sformatf("SUMMARY frames=%0d bytes=%0d expected_fcs=%08h tx_error=%0b content_errors=%0d", env.rgmii_ag.mon.tx_frame_count, env.rgmii_ag.mon.tx_byte_count, expected_fcs, env.rgmii_ag.mon.tx_error_seen, rgmii_byte_errors), UVM_LOW)

        // IRQ001_SELF_CHECK
        irq001_failed = 1'b0;
        irq001_timeout = 0;

        while (irq_vif.irq_tx_compl !== 1'b1 &&
               irq001_timeout < 200) begin
            @(negedge irq_vif.clk);
            irq001_timeout++;
        end

        if (irq_vif.irq_tx_compl !== 1'b1) begin
            irq001_failed = 1'b1;
            `uvm_error("IRQ001_TIMEOUT",
                "TX completion interrupt did not assert within 200 cycles")
        end
        else begin
            `uvm_info("IRQ001_PASS",
                "TX completion interrupt asserted", UVM_LOW)
        end

        if (irq_vif.irq_rx_compl !== 1'b0 ||
            irq_vif.irq_dma_err !== 1'b0) begin
            irq001_failed = 1'b1;
            `uvm_error("IRQ001_ISOLATION",
                "RX completion or DMA error interrupt asserted unexpectedly")
        end
        else
            `uvm_info("IRQ001_PASS",
                "RX and DMA error IRQs remained low", UVM_LOW)

        if (!irq001_failed) begin
            irq001_seq = eth_irq001_csr_seq::type_id::create("irq001_seq");
            irq001_seq.start(env.axil_ag.sqr);

            if (irq001_seq.failed)
                irq001_failed = 1'b1;

            repeat (5) @(negedge irq_vif.clk);

            if ({irq_vif.irq_dma_err,
                 irq_vif.irq_rx_compl,
                 irq_vif.irq_tx_compl} !== 3'b000) begin
                irq001_failed = 1'b1;
                `uvm_error("IRQ001_CLEAR",
                    "Interrupt outputs did not deassert after W1C")
            end
        end

        if (irq001_failed)
            `uvm_error("IRQ001_FAIL", "IRQ-001 verification failed")
        else
            `uvm_info("IRQ001_PASS",
                "IRQ-001 TX COMPLETION INTERRUPT TEST PASSED", UVM_LOW)

        phase.drop_objection(this);                                                       // Allows the test to finish after DMA, MAC-input AXIS, and RGMII observation complete.

    endtask

endclass
